---
// Assets
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="overflow-hidden">
  <Wrapper class="pt-20 lg:pt-28">
    <div class="mx-auto max-w-2xl text-center">
      <div class="text-balance">
        <Text
          tag="h1"
          variant="displayMD"
          class="text-foreground font-display tracking-tight"
        >
          Pripravite vaš razvoji proces na revizijo SOC 2, ISO 27034 in NIS2
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="text-muted-foreground mt-3 font-normal"
        >
          Pomagamo razvojem ekipam vzpostaviti varen življenjski krog razvoja programske opreme (Secure SDLC), avtomatizirati preverjanje skladnosti v CI/CD ter uspešno prestati uradne revizije.
        </Text>
      </div>
      <div class="mx-auto mt-6 flex w-fit flex-wrap justify-center gap-2">
        <Button
          variant="default"
          size="xs"
          isLink
          href="#kontakt"
        >
          Rezervirajte uvodni posvet
        </Button>
        <Button
          variant="muted"
          size="xs"
          isLink
          href="#storitve"
        >
          Pregled storitev
        </Button>
      </div>
    </div>    
  </Wrapper>
</section>  