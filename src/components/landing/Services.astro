---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const features = [
  "SOC 2 Type II",
  "ISO 27034 (Application Security)",
  "NIS2 Direktiva",
  "Secure SDLC Architecture",
  "SAST / DAST Integracija",
  "Dependency Scanning",
  "Git Flow & Branch Governance",
  "Secrets Management",
  "CI/CD Pipeline Security",
  "Threat Modeling",
  "Code Review Automation",
  "Audit-ready Evidence",
];

const featureItems = [
  {
    title: "Ocena stanja (Gap Analysis)",
    description:
      "Pregled obstoječih Git procesov, CI/CD cevovodov in varnostnih kontrol z jasnim načrtom do certifikacije.",
  },
  {
    title: "Varno upravljanje kode",
    description:
      "Vzpostavitev strogih pravil za veje (Branch Governance), obveznih odobritev in avtomatiziranih pregledov kode.",
  },
  {
    title: "Integracija SAST / DAST",
    description:
      "Samodejno skeniranje kode in odvisnosti (SST, SCA) neposredno v vaših CI/CD cevovodih brez zaustavljanja razvoja.",
  },
  {
    title: "Upravljanje skrivnosti",
    description:
      "Varna hramba API ključev in gesel ter odprava trdo kodiranih skrivnosti v repozitorijih.",
  },
  {
    title: "Varni razvojni proces (Secure SDLC)",
    description:
      "Vpeljava varnostnih zahtev v vsako fazo razvoja – od načrtovanja funkcij do produkcijske namestitve.",
  },
  {
    title: "NIS2 & ISO 27034 skladnost",
    description:
      "Prilagoditev arhitekture in procesov specifičnim zahtevam evropske direktive NIS2 ter standarda ISO 27034.",
  },
  {
    title: "Avtomatizacija dokazov za revizijo",
    description:
      "Sistematsko zbiranje revizijskih sledi (Audit Trail) iz Git in CI/CD orodij za zunanje presojevalce.",
  },
  {
    title: "Spremstvo pri reviziji (Audit Companion)",
    description:
      "Neposredna podpora vaši ekipi med tehničnim pregledom zunanjih auditorjev za SOC 2 ali ISO presoje.",
  },
];
---

<section id="storitve" class="pt-8">
  <Wrapper variant="default" class="py-20">
    <div class="mx-auto max-w-xl text-center">
      <div class="text-balance">
        <Text
          tag="h2"
          variant="displayMD"
          class="text-foreground font-display tracking-tight"
        >
          Celoletna varnost in skladnost vaše programske opreme
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="text-muted-foreground mt-1.5 font-normal"
        >
          Od analize vrzeli do avtomatizirane CI/CD varnosti in uspešno opravljene revizije.
        </Text>
      </div>
    </div>

    <div class="relative mx-auto overflow-hidden overflow-x-hidden py-12">
      <div class="grid w-full justify-between">
        <div
          class="from-muted absolute inset-0 left-0 z-10 w-44 bg-linear-to-r via-transparent"
        >
        </div>
        <div
          class="from-muted absolute inset-0 left-0 z-10 ml-auto w-44 bg-linear-to-l via-transparent"
        >
        </div>
      </div>
      <div class="relative flex items-center gap-2 whitespace-nowrap">
        {
          features.map((feature) => (
            <span class="text-foreground/80 bg-background border border-border relative inline-flex items-center rounded-lg px-4 py-1.5 text-sm font-medium">
              {feature}
            </span>
          ))
        }
      </div>
    </div>

    <div
      class="mx-auto mt-12 grid max-w-6xl gap-x-6 gap-y-8 text-balance sm:grid-cols-2 lg:grid-cols-4 lg:text-center"
    >
      {
        featureItems.map((item) => (
          <div class="space-y-1">
            <h3 class="text-foreground text-base font-medium">{item.title}</h3>
            <p class="text-muted-foreground text-sm text-pretty">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>