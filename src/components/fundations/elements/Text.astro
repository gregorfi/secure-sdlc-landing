---
export interface Props {
  tag?:
    | "a"
    | "p"
    | "em"
    | "span"
    | "small"
    | "strong"
    | "blockquote"
    | "div"
    | "summary"
    | "label"
    | "h1"
    | "h2"
    | "h3"
    | "h4"
    | "h5"
    | "h6";
  id?: string;
  rel?: string;
  style?: string;
  target?: string;
  href?: string;
  title?: string;
  variant?: string;
  class?: string;
  ariaLabel?: string;
}

const textStyles: Record<string, string> = {
  displayTitle: "text-2xl md:text-3xl lg:text-4xl leading-tight text-balance",
  displaySubTitle: "text-base md:text-lg",
  
  // Zmanjšane variante za naslove (odstranjeni ogromni 2xl:text-... skoki):
  display2XL: "text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-balance",
  displayXL:  "text-3xl sm:text-3xl md:text-4xl lg:text-5xl leading-tight text-balance",
  displayLG:  "text-2xl sm:text-2xl md:text-3xl lg:text-4xl leading-tight text-balance",
  displayMD:  "text-xl sm:text-xl md:text-2xl lg:text-3xl leading-tight text-balance",
  displaySM:  "text-lg lg:text-xl text-balance",
  displayXS:  "text-base md:text-lg lg:text-xl",

  textXL: "text-xl md:text-2xl",
  textLG: "text-base sm:text-lg md:text-xl",
  textBase: "text-base",
  textSM: "text-sm",
  textXS: "text-xs",
  textXXS: "text-[0.65rem] md:text-xs",
};

const {
  tag: Tag = "p",
  class: className = "",
  variant = "textBase",
  ...rest
} = Astro.props;

const baseClasses = textStyles[variant] || textStyles.textBase;
const combinedClasses = `${baseClasses} ${className}`.trim();
---

<Tag class={combinedClasses} {...rest}>
  <slot name="left-icon" />
  <slot />
  <slot name="right-icon" />
</Tag>
