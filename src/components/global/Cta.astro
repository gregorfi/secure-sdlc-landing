---
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section id="kontakt" class="bg-muted/50 border-t border-border py-20">
  <Wrapper variant="default">
    <div class="mx-auto max-w-xl text-center">
      <Text
        tag="h2"
        variant="displayMD"
        class="text-foreground font-display tracking-tight"
      >
        Rezervirajte uvodni posvet
      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="text-muted-foreground mt-3 font-normal"
      >
        Pošljite povpraševanje ali vprašanje glede analize vrzeli in avtomatizacije Secure SDLC procesov. Odgovorimo v najkrajšem možnem času.
      </Text>

      <!-- Kontaktni obrazec -->
      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="mt-8 space-y-4 text-left"
      >
        <!-- Web3Forms Access Key (Zamenjajte s svojim ključem) -->
        <input type="hidden" name="access_key" value="VAŠ_ACCESS_KEY_TUKAJ" />

        <!-- Nastavitev zadeve e-pošte -->
        <input type="hidden" name="subject" value="Novo povpraševanje za Secure SDLC svetovanje" />

        <!-- Honeypot polje za preprečevanje spama (skrito za prave uporabnike) -->
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

        <div>
          <label for="name" class="block text-sm font-medium text-foreground mb-1">
            Ime in priimek
          </label>
          <input
            type="text"
            name="name"
            id="name"
            required
            placeholder="Janez Novak"
            class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-foreground mb-1">
            E-poštni naslov
          </label>
          <input
            type="email"
            name="email"
            id="email"
            required
            placeholder="janez@podjetje.si"
            class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
          />
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-foreground mb-1">
            Sporočilo / Opis projekta
          </label>
          <textarea
            name="message"
            id="message"
            rows="4"
            required
            placeholder="Zanima nas ocena pripravljenosti na NIS2/SOC 2 ter integracija SAST orodij v naš CI/CD..."
            class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
          ></textarea>
        </div>

        <div>
          <Button type="submit" variant="default" size="md" class="w-full justify-center">
            Pošlji povpraševanje
          </Button>
        </div>
      </form>
    </div>
  </Wrapper>
</section>